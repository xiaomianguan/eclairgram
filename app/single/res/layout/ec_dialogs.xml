<?xml version="1.0" encoding="utf-8"?>
<!-- 会话列表：账号有会话文件夹时用原生标签栏（TabWidget）替代标题栏，
     没有文件夹时仍显示标题栏。内容（ListView）由所有标签共用。 -->
<TabHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/tabhost"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/ec_window_bg">

        <!-- 没有文件夹时显示标题栏。ec_title_bar 是给 48dip 头像聊天头设计的
             9-patch，自带较大的最小高度，直接 wrap_content 会把标题栏撑得很高；
             这里给标题栏一个正常高度，标题栏本身是固定高，标签栏出现时才会变高。 -->
        <TextView android:id="@+id/ec_title"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/ec_title_height"
            android:background="@drawable/ec_title_bar"
            android:gravity="center_vertical"
            android:paddingLeft="8.0dip"
            android:paddingRight="8.0dip"
            android:text="@string/ec_dialogs_title"
            android:textColor="#ffffffff"
            android:textStyle="bold"
            android:textSize="16.0sp"
            android:singleLine="true" />

        <HorizontalScrollView android:id="@+id/ec_tabscroll"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <TabWidget android:id="@android:id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>

        <!-- 搜索模式（菜单/系统搜索键触发）时显示的搜索框 -->
        <LinearLayout android:id="@+id/ec_search_bar"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/ec_title_bar"
            android:gravity="center_vertical"
            android:padding="4.0dip"
            android:visibility="gone">

            <EditText android:id="@+id/ec_search_input"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:hint="@string/ec_search_hint"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch" />
        </LinearLayout>

        <FrameLayout android:id="@android:id/tabcontent"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_weight="1.0">

            <FrameLayout android:id="@+id/ec_tabcontent"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">

                <TextView android:id="@+id/ec_empty"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:padding="16.0dip"
                    android:text="@string/ec_status_loading"
                    android:textColor="@color/ec_text_secondary"
                    android:visibility="gone" />

                <ListView android:id="@+id/ec_list"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:cacheColorHint="@color/ec_window_bg"
                    android:divider="#00000000"
                    android:dividerHeight="0.0dip"
                    android:listSelector="@drawable/ec_list_selector"
                    android:drawSelectorOnTop="true" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</TabHost>
