<?xml version="1.0" encoding="utf-8"?>
<!-- 会话列表：复用 Talk 的配色与头像/状态图 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#ffffffff">

    <TextView android:id="@+id/ec_title"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#ff2f3d4a"
        android:padding="6.0dip"
        android:text="@string/ec_dialogs_title"
        android:textColor="#ffffffff"
        android:textStyle="bold" />

    <TextView android:id="@+id/ec_empty"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:padding="16.0dip"
        android:text="@string/ec_status_loading"
        android:textColor="@color/status"
        android:visibility="gone" />

    <ListView android:id="@+id/ec_list"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:cacheColorHint="#00000000"
        android:divider="#ffe0e0e0"
        android:dividerHeight="1.0dip" />
</LinearLayout>
