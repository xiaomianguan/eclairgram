<?xml version="1.0" encoding="utf-8"?>
<!-- 聊天界面：顶部联系人标题栏（贴近原版 Talk）+ 消息列表 + 输入行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/ec_window_bg">

    <LinearLayout android:id="@+id/ec_chat_header"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ec_title_bar"
        android:paddingLeft="4.0dip"
        android:paddingTop="4.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="4.0dip">

        <android.widget.QuickContactBadge android:id="@+id/ec_header_avatar"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            style="?android:attr/quickContactBadgeStyleWindowMedium" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_gravity="center_vertical"
            android:paddingLeft="8.0dip">

            <TextView android:id="@+id/ec_chat_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="#ffffffff"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView android:id="@+id/ec_chat_subtitle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="#ffd0d0d0"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView android:id="@+id/ec_header_presence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:scaleType="fitXY"
            android:src="@android:drawable/presence_online" />
    </LinearLayout>

    <ListView android:id="@+id/ec_messages"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0"
        android:cacheColorHint="@color/ec_window_bg"
        android:transcriptMode="normal"
        android:stackFromBottom="true" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@color/ec_input_bg">

        <ImageButton android:id="@+id/ec_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="#00000000"
            android:contentDescription="@string/ec_emoji"
            android:src="@drawable/ic_menu_emoticons" />

        <ImageButton android:id="@+id/ec_attach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="#00000000"
            android:contentDescription="@string/ec_attach"
            android:src="@drawable/ec_attach" />

        <EditText android:id="@+id/ec_input"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:hint="@string/ec_message_hint"
            android:textColor="@color/ec_text_primary"
            android:singleLine="true"
            android:inputType="textShortMessage|textAutoCorrect" />

        <Button android:id="@+id/ec_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_send" />
    </LinearLayout>
</LinearLayout>
