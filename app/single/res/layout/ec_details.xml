<?xml version="1.0" encoding="utf-8"?>
<!-- 联系人 / 群组 / 频道详情页（贴近原版 Talk 的联系人页） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/ec_window_bg">

    <LinearLayout android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ec_header"
        android:paddingLeft="8.0dip"
        android:paddingTop="8.0dip"
        android:paddingRight="8.0dip"
        android:paddingBottom="8.0dip">

        <ImageView android:id="@+id/ec_detail_avatar"
            android:layout_width="64.0dip"
            android:layout_height="64.0dip"
            android:layout_gravity="center_vertical"
            android:background="@drawable/im_avatar_picture_border_normal"
            android:scaleType="fitXY"
            android:src="@drawable/ic_contact_picture" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_gravity="center_vertical"
            android:paddingLeft="10.0dip">

            <TextView android:id="@+id/ec_detail_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:textAppearanceLarge"
                android:textColor="#ffffffff"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView android:id="@+id/ec_detail_status"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="#ffd0d0d0"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_weight="1.0">

        <LinearLayout android:id="@+id/ec_detail_fields"
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:padding="12.0dip" />
    </ScrollView>
</LinearLayout>
