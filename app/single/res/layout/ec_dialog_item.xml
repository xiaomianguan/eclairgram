<?xml version="1.0" encoding="utf-8"?>
<!-- 好友条目：气泡背景（Talk 的 im_bubble_normal 选择器）+ 头像 + 状态图标 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="2.0dip"
    android:paddingTop="3.0dip"
    android:paddingRight="2.0dip"
    android:paddingBottom="3.0dip">

    <ImageView android:id="@+id/ec_avatar"
        android:layout_width="48.0dip"
        android:layout_height="48.0dip"
        android:layout_gravity="center_vertical"
        android:scaleType="fitXY"
        android:src="@drawable/ic_contact_picture" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:background="@drawable/bubble"
        android:gravity="center_vertical">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:paddingLeft="10.0dip"
            android:paddingTop="4.0dip"
            android:paddingBottom="4.0dip">

            <TextView android:id="@+id/ec_name"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@color/online_text_color"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView android:id="@+id/ec_status"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@color/status"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView android:id="@+id/ec_presence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingLeft="2.0dip"
            android:paddingRight="8.0dip"
            android:scaleType="fitXY"
            android:src="@android:drawable/presence_online" />
    </LinearLayout>
</LinearLayout>
