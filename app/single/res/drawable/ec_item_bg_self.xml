<?xml version="1.0" encoding="utf-8"?>
<!-- 置顶的“收藏夹/我的资料”整行背景，仿原版 Talk 的
     roster_list_self_status_background（BuddyList.mSelfItem → overrideBackground）：
     常态是整行纯色；按下/选中为透明，高亮交给系统列表选择器，
     因此会随 Android 版本变化。颜色本身也按版本区分（values / values-v8）。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@android:color/transparent" />
    <item android:state_selected="false" android:state_pressed="true"
        android:drawable="@android:color/transparent" />
    <item android:drawable="@color/ec_self_bg" />
</selector>
