<?xml version="1.0" encoding="utf-8"?>
<!-- 可聚焦行的背景：常态透明，聚焦/按下时高亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/ec_row_focus" />
    <item android:state_pressed="true" android:drawable="@drawable/ec_row_focus" />
    <item android:drawable="@android:color/transparent" />
</selector>
