<?xml version="1.0" encoding="utf-8"?>
<!--
  Eclairgram：独立应用，只复用 Google Talk 的界面资源。

  只有一个启动入口（.MainActivity）：未登录时显示登录页，已登录则直接进入会话列表。
  Telegram 协议由 telegram/ 的原生 MTProto 实现负责，不依赖任何 Google 组件。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.wuersan008.eclairgram"
    android:versionCode="1"
    android:versionName="0.3">

    <uses-sdk android:minSdkVersion="7" android:targetSdkVersion="7" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application android:label="@string/ec_app_name"
        android:icon="@drawable/ic_launcher_eclairgram">

        <activity android:name=".MainActivity"
            android:label="@string/ec_app_name"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".DialogsActivity"
            android:label="@string/ec_dialogs_title"
            android:screenOrientation="portrait" />

        <activity android:name=".ChatActivity"
            android:label="@string/ec_app_name"
            android:screenOrientation="portrait" />

        <activity android:name=".CameraActivity"
            android:label="@string/ec_attach_camera"
            android:screenOrientation="portrait" />

        <activity android:name=".DetailsActivity"
            android:label="@string/ec_details_title"
            android:exported="true"
            android:screenOrientation="portrait" />

        <activity android:name=".SettingsActivity"
            android:label="@string/ec_settings"
            android:screenOrientation="portrait" />

        <activity android:name=".MediaActivity"
            android:label="@string/ec_app_name"
            android:exported="true"
            android:screenOrientation="portrait" />

        <service android:name=".TelegramService" />
    </application>
</manifest>
