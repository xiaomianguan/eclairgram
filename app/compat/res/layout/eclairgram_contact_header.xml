<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 4.0 兼容替身用的联系人标题布局。
  结构与 2.1 框架的 res/layout/contact_header.xml 保持一致（背景、头像、名称、
  在线状态图标），仅供 ContactHeaderWidget 替身在 4.0+ 使用；2.1–2.3 仍由系统
  框架的原版控件与布局渲染，界面不变。
-->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="horizontal"
  android:background="@drawable/liangmian_title_bar_medium"
  android:paddingRight="5.0dip"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent">
    <QuickContactBadge
        android:id="@+id/contact_header_photo"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="-1.0dip"
        android:layout_marginRight="8.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_gravity="center_vertical"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.0">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/contact_header_name"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:singleLine="true"
                android:shadowColor="#bb000000"
                android:shadowRadius="3.0"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:id="@+id/contact_header_status"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <ImageView
        android:id="@+id/contact_header_presence"
        android:layout_gravity="center_vertical"
        android:paddingLeft="3.0dip"
        android:paddingRight="6.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
