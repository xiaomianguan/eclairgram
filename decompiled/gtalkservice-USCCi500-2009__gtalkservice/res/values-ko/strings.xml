<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_label">Google 토크 서비스</string>
    <string name="perm_label">Google Talk 채팅 메시지 보내고 받기</string>
    <string name="perm_desc">응용프로그램이 Google 토크 서비스를 사용하여 채팅 메시지를 보내고 받을 수 있게 합니다. 이 서비스를 사용하면 데이터를 소비하게 되며 악성 응용프로그램이 과다한 데이터 사용을 유발할 수 있습니다.</string>
    <string name="perm_data_label">데이터 메시지 보내기</string>
    <string name="perm_data_desc">응용프로그램이 다른 Google 계정 사용자에게 데이터 메시지를 보낼 수 있도록 합니다. 응용프로그램은 명시적인 동의 여부에 관계없이 백그라운드로 메시지를 보낼 수 있습니다. 이 서비스를 사용하면 데이터를 소비하게 되며 악성 응용프로그램이 과다한 데이터 사용을 유발할 수 있습니다.</string>
    <string name="perm_receive_data_message_label">메시지 및 알림 수신</string>
    <string name="perm_receive_data_message_desc">응용프로그램이 응용프로그램 서버에서 보낸 메시지와 알림을 수신할 수 있도록 합니다. 이 서비스를 사용하면 데이터를 소비하게 되며 악성 응용프로그램이 과다한 데이터 사용을 유발할 수 있습니다.</string>
    <string name="perm_data_msg_broadcast_label">데이터 메시지를 응용프로그램에 전달합니다.</string>
    <string name="perm_data_msg_broadcast_desc">인터넷에서 수신한 데이터 메시지를 등록된 응용프로그램으로 전달할 수 있습니다.</string>
    <string name="permlab_intentVendingOnly">Android 마켓에 브로드캐스트 보내기</string>
    <string name="permdesc_intentVendingOnly">응용프로그램 설치 및 삭제를 요청하는 브로드캐스트를 Android 마켓에 보낼 수 있습니다.</string>
    <string name="permlab_heartbeat">Google 토크 서버로 하트비트 보내기</string>
    <string name="permdesc_heartbeat">하트비트 패킷을 Google 토크 서버로 보내어 연결 상태를 보장할 수 있습니다.</string>
    <string name="group_chat">그룹 채팅: %s</string>
